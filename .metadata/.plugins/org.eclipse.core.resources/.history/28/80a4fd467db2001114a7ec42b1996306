int _write(int file, char *ptr, int len){
	HAL_UART_Transmit(&huart2, (uint8_t *)ptr, len, HAL_MAX_DELAY);
	return len;
}

int8_t bme280_i2c_read(uint8_t reg_addr, uint8_t *reg_data, uint32_t len, void* intf_ptr){

	uint8_t dev_addr = *(uint8_t*)intf_ptr;
	uint16_t hal_addr = (uint16_t)(dev_addr << 1);

	HAL_StatusTypeDef status = HAL_I2C_Mem_Read(&hi2c1, hal_addr, reg_addr, I2C_MEMADD_SIZE_8BIT, reg_data, (uint16_t)len, 100);

	if (status == HAL_OK)
		return BME280_INTF_RET_SUCCESS;

	return -1;
}

int8_t bme280_i2c_write(uint8_t reg_addr, const uint8_t *reg_data, uint32_t len, void* intf_ptr){

	uint8_t dev_addr = *(uint8_t*)intf_ptr;
	uint16_t hal_addr = (uint16_t)(dev_addr << 1);

	HAL_StatusTypeDef status = HAL_I2C_Mem_Write(&hi2c1, hal_addr, reg_addr, I2C_MEMADD_SIZE_8BIT, (uint8_t *)reg_data, (uint16_t)len, 100);

	if (status == HAL_OK)
		return BME280_INTF_RET_SUCCESS;

	return -1;
}

void bme280_delay_us(uint32_t period, void *intf_ptr){
	uint32_t delay_ms = (period / 1000) + 1;
	HAL_Delay(delay_ms);
}
