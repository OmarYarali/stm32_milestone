/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */

  int8_t rslt;
  struct bme280_dev dev;
  struct bme280_settings settings;

  uint8_t dev_addr = BME280_I2C_ADDR_PRIM;

  dev.intf_ptr = &dev_addr;
  dev.intf = BME280_I2C_INTF;
  dev.read = bme280_i2c_read;
  dev.write = bme280_i2c_write;
  dev.delay_us = bme280_delay_us;


  rslt = bme280_init(&dev);
  if (rslt != BME280_OK)
	  printf("Failed to initialize BME280! Error: %d\r\n", rslt);

  printf("dig_t1 value: %d\r\n", dev.calib_data.dig_t1);


  settings.osr_h = BME280_OVERSAMPLING_1X;
  settings.osr_p = BME280_OVERSAMPLING_16X;
  settings.osr_t = BME280_OVERSAMPLING_2X;
  settings.filter = BME280_FILTER_COEFF_16;
  settings.standby_time = BME280_STANDBY_TIME_62_5_MS;

  uint8_t settings_sel = BME280_SEL_OSR_PRESS | BME280_SEL_OSR_TEMP | BME280_SEL_OSR_HUM | BME280_SEL_FILTER | BME280_SEL_STANDBY;

  rslt = bme280_set_sensor_settings(settings_sel, &settings, &dev);
  printf("Settings: %d\r\n", rslt);

  rslt = bme280_set_sensor_mode(BME280_POWERMODE_NORMAL, &dev);
  printf("Mode: %d\r\n", rslt);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */


  struct bme280_data comp_data;
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

	  rslt = bme280_get_sensor_data(BME280_ALL, &comp_data, &dev);

	  if (rslt == BME280_OK){
		  printf("Temp: %.2f C, Press: %.2f Pa, Hum: %.2f %%\r\n", comp_data.temperature, comp_data.pressure, comp_data.humidity);
	  }

	  HAL_Delay(1000);

  }
  /* USER CODE END 3 */
}

