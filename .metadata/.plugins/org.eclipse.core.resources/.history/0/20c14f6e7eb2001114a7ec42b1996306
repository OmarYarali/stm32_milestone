	uint16_t hal_addr = (uint16_t)(deviceAddress << 1);
	return (HAL_I2C_Mem_Write(&hi2c1, hal_addr, startRegisterAddress, I2C_MEMADD_SIZE_8BIT, data, dataLength, 100) == HAL_OK) ? 0 : -1;
}

